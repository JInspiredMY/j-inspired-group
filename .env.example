# Copy to .env.local for local dev. See CLAUDE.md's Environment variables
# table for scope (server/client) and where each is set in Vercel.

# --- Existing (institutional pages) ---
RESEND_API_KEY=
RESEND_TO_EMAIL=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_ID=
NEXT_PUBLIC_SITE_DOMAIN=

# --- Phase 1 platform build (R1, design brief v1.4 Appendix A) ---

# Supabase (Postgres). Pooled = app runtime (Supavisor, transaction mode,
# port 6543). Direct = migrations only (port 5432) — used by
# drizzle.config.ts, never imported at runtime.
DATABASE_URL=
DIRECT_URL=

# Clerk (auth/RBAC) — journeyinspired.group /admin only, no customer-facing
# accounts in R1-R4.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
